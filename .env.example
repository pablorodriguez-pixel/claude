# Copia este fichero a .env.local y rellena los valores.
# .env.local esta en .gitignore — NUNCA se commitea.

# Token de la Vercel API.
# Generar en: https://vercel.com/account/settings/tokens
# Dale el scope minimo necesario (un solo equipo, no "full account").
VERCEL_TOKEN=vck_xxxxxxxxxxxxxxxxxxxxxxxx

# Equipo por defecto. Se inyecta como ?teamId= en todas las llamadas.
# Obtenerlo con: ./scripts/vc teams
VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxxxxxx

# Variables que hay que crear en Vercel (Settings → Environment Variables).
# Para probar en local: copia este archivo como .env.local y ejecuta `npm run dev`.

# Correo IONOS (solo lectura)
IONOS_EMAIL=tu@tudominio.com
IONOS_PASSWORD=
# IONOS_IMAP_HOST=imap.ionos.es

# Acceso al conector desde Claude
CONNECTOR_PASSWORD=        # mínimo 12 caracteres: la escribirás al conectar en Claude
TOKEN_SECRET=              # mínimo 32 caracteres aleatorios

# Google Drive (Apps Script receptor)
DRIVE_WEBAPP_URL=          # https://script.google.com/macros/s/.../exec
DRIVE_SECRET=              # la misma clave que SECRETO en ReceptorDrive.gs (mínimo 32)

# Tarea diaria
CRON_SECRET=               # mínimo 16 caracteres aleatorios

# ZONA_HORARIA=Europe/Madrid
